# Anthropic API Key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail OAuth2 credentials path (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_PATH=credentials/client_secret.json

# Token cache path (auto-generated after first login)
GMAIL_TOKEN_PATH=credentials/token.json

# OpenAI API Key — required for RAG (embedding via text-embedding-3-small)
# If not set, RAG is silently disabled and drafts are generated without context.
OPENAI_API_KEY=your_openai_api_key_here

# ChromaDB local storage path (default: .chroma_db in project root)
CHROMA_DB_PATH=.chroma_db
